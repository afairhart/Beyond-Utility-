rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // True only when the signed-in user's own profile has role == admin.
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      // A user can read their own profile; admins can read, list, and write any.
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();

      // A user may update only their own login-activity fields — nothing else
      // (notably not their own role).
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt', 'loginCount']);
    }

    // Deal pipeline, LinkedIn data, and settings (API keys) — admin only.
    // The per-company activity subcollection (timestamped notes, calls,
    // status changes) inherits the same admin-only access.
    match /pipeline_companies/{docId} {
      allow read, write: if isAdmin();
      match /activity/{entryId} { allow read, write: if isAdmin(); }
    }
    match /linkedinConnections/{docId}    { allow read, write: if isAdmin(); }
    match /linkedinMessages/{docId}       { allow read, write: if isAdmin(); }
    match /linkedinInvitations/{docId}    { allow read, write: if isAdmin(); }
    match /linkedinCompanyFollows/{docId} { allow read, write: if isAdmin(); }
    match /settings/{docId}               { allow read, write: if isAdmin(); }

    // Usage counters — admins may read; only Cloud Functions (Admin SDK) write.
    match /usage/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
